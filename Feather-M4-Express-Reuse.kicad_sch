	(text "PCC:\nDEN1: SDA\nDEN2: SCL\nCLK: D6\nD0: D11\nD1: D13\nD2: D10\nD3: D12\nD4: MISO\nD5: D5\nD6: MOSI\nD7: SCK\n\nSPI:\nSERCOM1 DOPO = 0x3, SCK.1 & MO.3, MI.2\n\nI2C:\nSERCOM2 or 4\n\nUART:\nSERCOM5, TX on .0 & RX on .1\n\nSPI Flash:\nQSPI (dual io)\nInternal SPI on SERCOM 2\n\nI2S:\nSCK0: A2\nFS0: MISO\nSDI: MOSI\nSDO: D5\n\nTCC1:\nWO0: D11\nWO1: D13\nWO2: D10\nWO3: D12\nWO4: MISO\nWO5: D5\nWO6: MOSI\nWO7: SCK"
		(exclude_from_sim no)
		(at 190.754 203.454 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "156236ff-941e-4bf6-8e86-1dc17204849c")
	)
